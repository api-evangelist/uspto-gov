{
  "opencollection": "1.0.0",
  "info": {
    "name": "USPTO Bulk Data Storage System (BDSS) Appeals API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Appeals",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search Appeal Decisions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.uspto.gov/api/v1/ptab/appeals/search",
            "params": [
              {
                "name": "applicationNumberText",
                "value": "",
                "type": "query"
              },
              {
                "name": "decisionDateFrom",
                "value": "",
                "type": "query"
              },
              {
                "name": "decisionDateTo",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search Appeal Decisions"
        },
        {
          "info": {
            "name": "Search Interference Decisions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.uspto.gov/api/v1/ptab/interferences/search",
            "params": [
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search Interference Decisions"
        }
      ]
    }
  ],
  "bundled": true
}